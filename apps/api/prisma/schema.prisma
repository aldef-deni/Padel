generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  CLUB_ADMIN
  PLAYER
}

enum ClipStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model Club {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  address     String?
  timezone    String   @default("Asia/Jakarta")
  // Profil & kontak klub (semua opsional).
  city        String?
  description String?
  phone       String?
  email       String?
  website     String?
  instagram   String?
  mapsUrl     String?
  // Jam operasional "HH:mm" (zona waktu klub).
  openTime    String?
  closeTime   String?
  // false = klub dinonaktifkan: admin klub tidak bisa login, sesi/replay/TV berhenti.
  isActive    Boolean  @default(true)
  // Nama file logo di LOGOS_DIR (berubah setiap upload, sekalian cache-buster).
  logoFile    String?
  // Kunci rahasia link layar TV (/tv/<clubId>?key=...); diganti = link lama mati.
  tvKey       String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courts      Court[]
  admins      User[]
  members     ClubMember[]
  tournaments Tournament[]
}

model Court {
  id        String   @id @default(cuid())
  clubId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club     Club              @relation(fields: [clubId], references: [id], onDelete: Restrict)
  cameras  Camera[]
  sessions Session[]
  matches  TournamentMatch[]

  @@unique([clubId, name])
}

model Camera {
  id         String   @id @default(cuid())
  courtId    String
  name       String
  // Path MediaMTX tempat kamera publish, mis. "court-1".
  streamPath String   @unique
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  court Court  @relation(fields: [courtId], references: [id], onDelete: Restrict)
  clips Clip[]

  @@index([courtId])
}

model User {
  id                String    @id @default(cuid())
  // Admin login dengan email atau username + password.
  email             String?   @unique
  // Huruf kecil, 3-32 karakter: a-z 0-9 . _ -
  username          String?   @unique
  // Pemain login dengan OTP ke nomor ini (format E.164, mis. +628123456789).
  phone             String?   @unique
  name              String?
  passwordHash      String?
  // Token yang dibuat sebelum waktu ini ditolak (logout paksa setelah ganti password).
  passwordChangedAt DateTime?
  role              Role      @default(PLAYER)
  // false = akun dinonaktifkan: tidak bisa login, token yang ada langsung ditolak.
  isActive          Boolean   @default(true)
  lastLoginAt       DateTime?
  // Nama file foto profil di AVATARS_DIR (berubah setiap upload).
  avatarFile        String?
  // Hanya untuk CLUB_ADMIN: klub yang dikelola.
  clubId            String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  club        Club?            @relation(fields: [clubId], references: [id], onDelete: SetNull)
  sessions    SessionPlayer[]
  clips       Clip[]
  memberships ClubMember[]
  teamsAsP1   TournamentTeam[] @relation("TeamPlayer1")
  teamsAsP2   TournamentTeam[] @relation("TeamPlayer2")
}

// Pemain yang terdaftar di sebuah klub (ditambah admin klub, atau otomatis saat join sesi via QR).
// Akun PLAYER bersifat global; keanggotaan ini yang menentukan pemain mana yang dikelola admin klub.
model ClubMember {
  clubId    String
  userId    String
  // Diblokir: tidak bisa join sesi di klub ini (akun tetap aktif di klub lain).
  isBlocked Boolean  @default(false)
  // Catatan internal admin klub.
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([clubId, userId])
  @@index([userId])
}

enum OtpChannel {
  WHATSAPP
  SMS
  EMAIL
}

model OtpCode {
  id         String     @id @default(cuid())
  // Nomor HP (E.164) untuk WHATSAPP/SMS, atau email (huruf kecil) untuk EMAIL.
  target     String
  channel    OtpChannel
  // HMAC kode OTP, kode aslinya tidak disimpan.
  codeHash   String
  expiresAt  DateTime
  attempts   Int        @default(0)
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([target, createdAt])
}

model Session {
  id        String    @id @default(cuid())
  courtId   String
  // Token di QR lapangan; pemain scan untuk bergabung.
  qrToken   String    @unique
  startedAt DateTime  @default(now())
  // null = sesi masih aktif.
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  court   Court           @relation(fields: [courtId], references: [id], onDelete: Restrict)
  players SessionPlayer[]
  clips   Clip[]

  @@index([courtId, endedAt])
}

model SessionPlayer {
  sessionId String
  userId    String
  joinedAt  DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionId, userId])
  @@index([userId])
}

model Clip {
  id            String     @id @default(cuid())
  sessionId     String
  cameraId      String
  requestedById String
  // Awal potongan (waktu rekaman MediaMTX) dan durasinya.
  startAt       DateTime
  durationSec   Int
  status        ClipStatus @default(PENDING)
  url           String?
  // Ukuran file klip tersimpan (byte), diisi saat READY.
  sizeBytes     Int?
  error         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  session     Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  camera      Camera  @relation(fields: [cameraId], references: [id], onDelete: Restrict)
  requestedBy User    @relation(fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([sessionId])
  @@index([status])
  @@index([createdAt])
}

// ---- Turnamen ----

enum TournamentFormat {
  // Sistem gugur
  SINGLE_ELIMINATION
  // Setengah kompetisi (semua bertemu semua)
  ROUND_ROBIN
  // Fase grup lalu sistem gugur
  GROUPS_KNOCKOUT
}

enum TournamentStatus {
  DRAFT
  REGISTRATION
  ONGOING
  COMPLETED
  CANCELLED
}

enum TournamentTeamStatus {
  REGISTERED
  CONFIRMED
  WITHDRAWN
}

enum TournamentStage {
  GROUP
  KNOCKOUT
}

enum TournamentMatchStatus {
  SCHEDULED
  COMPLETED
  // Menang tanpa bertanding (lawan mundur / tidak hadir)
  WALKOVER
  // Slot kosong di bagan: tim lolos otomatis
  BYE
}

model Tournament {
  id                   String           @id @default(cuid())
  clubId               String
  name                 String
  // Dipakai di URL publik /t/<slug>
  slug                 String           @unique
  category             String?
  description          String?
  startDate            DateTime
  endDate              DateTime?
  registrationDeadline DateTime?
  format               TournamentFormat
  status               TournamentStatus @default(DRAFT)
  maxTeams             Int?
  // Rupiah
  entryFee             Int?
  prizeInfo            String?
  isPublic             Boolean          @default(true)
  // Aturan skor: best of (2 * setsToWin - 1) set
  setsToWin            Int              @default(2)
  gamesPerSet          Int              @default(6)
  // Set penentu dimainkan sebagai super tie-break (sampai 10, selisih 2)
  superTiebreak        Boolean          @default(true)
  goldenPoint          Boolean          @default(true)
  // Fase grup
  groupCount           Int              @default(2)
  advancePerGroup      Int              @default(2)
  thirdPlaceMatch      Boolean          @default(false)
  championTeamId       String?          @unique
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  club     Club              @relation(fields: [clubId], references: [id], onDelete: Restrict)
  champion TournamentTeam?   @relation("TournamentChampion", fields: [championTeamId], references: [id], onDelete: SetNull)
  teams    TournamentTeam[]
  groups   TournamentGroup[]
  matches  TournamentMatch[]

  @@index([clubId, status])
}

model TournamentTeam {
  id           String               @id @default(cuid())
  tournamentId String
  name         String
  player1Name  String
  player2Name  String
  // Opsional: tautan ke akun pemain
  player1Id    String?
  player2Id    String?
  seed         Int?
  status       TournamentTeamStatus @default(REGISTERED)
  paid         Boolean              @default(false)
  note         String?
  groupId      String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  tournament Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  group      TournamentGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  player1    User?             @relation("TeamPlayer1", fields: [player1Id], references: [id], onDelete: SetNull)
  player2    User?             @relation("TeamPlayer2", fields: [player2Id], references: [id], onDelete: SetNull)
  championOf Tournament?       @relation("TournamentChampion")
  matchesA   TournamentMatch[] @relation("MatchTeamA")
  matchesB   TournamentMatch[] @relation("MatchTeamB")
  matchesWon TournamentMatch[] @relation("MatchWinner")

  @@unique([tournamentId, name])
  @@index([tournamentId])
}

model TournamentGroup {
  id           String @id @default(cuid())
  tournamentId String
  // "A", "B", ...
  name         String
  order        Int

  tournament Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teams      TournamentTeam[]
  matches    TournamentMatch[]

  @@unique([tournamentId, name])
}

model TournamentMatch {
  id               String                @id @default(cuid())
  tournamentId     String
  stage            TournamentStage
  groupId          String?
  // Grup: pekan/putaran; gugur: babak (1 = babak pertama)
  round            Int
  // Urutan di dalam babak
  position         Int
  teamAId          String?
  teamBId          String?
  courtId          String?
  scheduledAt      DateTime?
  status           TournamentMatchStatus @default(SCHEDULED)
  // [{ "a": 6, "b": 4 }, ...]
  sets             Json?
  winnerId         String?
  // Sistem gugur: pemenang maju ke nextMatchId di slot "A"/"B"
  nextMatchId      String?
  nextSlot         String?
  // Semifinal: yang kalah ke perebutan juara 3
  loserNextMatchId String?
  loserNextSlot    String?
  isThirdPlace     Boolean               @default(false)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  tournament Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  group      TournamentGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teamA      TournamentTeam?  @relation("MatchTeamA", fields: [teamAId], references: [id], onDelete: SetNull)
  teamB      TournamentTeam?  @relation("MatchTeamB", fields: [teamBId], references: [id], onDelete: SetNull)
  winner     TournamentTeam?  @relation("MatchWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  court      Court?           @relation(fields: [courtId], references: [id], onDelete: SetNull)

  @@index([tournamentId, stage, round])
}
