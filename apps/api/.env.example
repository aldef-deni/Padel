# Salin ke apps/api/.env. Nilai DB sama dengan infra/.env (POSTGRES_USER/PASSWORD/DB).
PORT=3000
# Alamat listen; default 127.0.0.1 (diakses lewat nginx / proxy Vite)
HOST=127.0.0.1
DATABASE_URL=postgresql://padel:ganti-dengan-password@127.0.0.1:5432/padel?schema=public

# JWT: minimal 32 karakter, buat dengan: openssl rand -base64 48
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRES_IN=7d

# Akun admin yang dibuat oleh `pnpm db:seed` (password hanya dipakai saat akun dibuat)
SEED_ADMIN_EMAIL=admin@padel.local
SEED_ADMIN_PASSWORD=ganti-dengan-password-kuat
SEED_CLUB_ADMIN_EMAIL=klub@padel.local
SEED_CLUB_ADMIN_PASSWORD=ganti-dengan-password-kuat

# API kontrol MediaMTX (hanya localhost) untuk status kamera
MEDIAMTX_API_URL=http://127.0.0.1:9997

# Redis untuk antrean BullMQ (password = REDIS_PASSWORD di infra/.env)
REDIS_URL=redis://:ganti-dengan-password@127.0.0.1:6379
# Playback server MediaMTX (hanya localhost) untuk mengambil klip
MEDIAMTX_PLAYBACK_URL=http://127.0.0.1:9996
# Folder penyimpanan klip lokal (nanti R2)
CLIPS_DIR=/opt/padel/data/clips
# URL publik situs (QR sesi & link TV), mis. https://padel.aldeftech.com
APP_PUBLIC_URL=http://localhost:5173

# Prefix key Redis BullMQ (opsional; e2e memakai padel-e2e)
BULLMQ_PREFIX=padel

# Folder logo klub (nanti R2)
LOGOS_DIR=/opt/padel/data/logos

# Folder foto profil pengguna (nanti R2)
AVATARS_DIR=/opt/padel/data/avatars
