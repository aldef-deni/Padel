# Salin ke infra/.env lalu isi dengan nilai asli. infra/.env TIDAK di-commit.

# PostgreSQL (127.0.0.1:5432)
POSTGRES_USER=padel
POSTGRES_PASSWORD=ganti-dengan-password-kuat
POSTGRES_DB=padel

# Redis (127.0.0.1:6379)
REDIS_PASSWORD=ganti-dengan-password-kuat

# Kredensial kamera untuk publish ke MediaMTX
#   RTMP: rtmp://<host>:1935/court-1?user=<CAMERA_USER>&pass=<CAMERA_PASS>
#   SRT : srt://<host>:8890?streamid=publish:court-1:<CAMERA_USER>:<CAMERA_PASS>
CAMERA_USER=camera
CAMERA_PASS=ganti-dengan-password-kuat

# UID/GID pemilik file rekaman di /opt/padel/data/recordings (opsional)
MEDIA_UID=1001
MEDIA_GID=1002
